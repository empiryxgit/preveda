# Copy to .env and edit. Every value is optional for local trials.
PREVEDA_HOSPITAL_NODE_ID=NODE-DEV
# off = no login (local trial only!) | hs256 = shared-secret JWT | jwks = Keycloak (production)
PREVEDA_AUTH_MODE=off
PREVEDA_JWT_SECRET=
PREVEDA_JWKS_URL=
PREVEDA_JWT_AUDIENCE=
# Salt used to pseudonymise patient references (SHA-256). Use a long random value per hospital and never change it.
PREVEDA_PATIENT_HASH_SALT=change-me-per-hospital
PREVEDA_REQUIRE_SIGNATURE=true
PREVEDA_STORE_THUMBNAILS=true
# Leave unset for the built-in SQLite file; production: postgresql+psycopg://user:pass@host:5432/preveda
# PREVEDA_DATABASE_URL=
# Folder on THIS computer holding retinal images (mounted read-only inside the container as /images)
PREVEDA_HOST_IMAGES_DIR=./images
# Dummy web login (doctor/doctor123, admin/admin123). Works only while PREVEDA_AUTH_MODE=off.
PREVEDA_DEMO_LOGIN=true
# Ports on THIS computer: REST API and web app
PREVEDA_API_PORT=8080
PREVEDA_WEB_PORT=8081
